# %% [markdown]
# ## 5. Data Cleaning
# 
# In this section we will:
# - Check for missing values
# - Check for duplicate entries
# - Fix data types
# - Remove columns that are not useful
# 

# %%
# Missing value analysis
missing = df.isnull().sum()
missing_pct = (missing / len(df) * 100).round(2)

missing_df = pd.DataFrame({
    'Missing Count': missing,
    'Missing %': missing_pct
})

missing_df = missing_df[missing_df['Missing Count'] > 0].sort_values('Missing %', ascending=False)
print(missing_df)


# %%
# Visualise missing values
plt.figure(figsize=(12, 6))
top_missing = missing_df.head(15)
plt.barh(top_missing.index, top_missing['Missing %'], color='steelblue')
plt.xlabel('Missing %')
plt.title('Top 15 Columns with Missing Values')
plt.tight_layout()
plt.show()

print("Insight: 'Movies' column is completely missing (100%). We will drop it.")
print("'Reviews', 'Notes', 'Score rank' also have large missing percentages.")


# %%
# Check duplicates
dup_count = df.duplicated(subset='Name').sum()
print("Duplicate game names:", dup_count)

# Drop duplicates
df.drop_duplicates(subset='Name', keep='first', inplace=True)
print("After removing duplicates:", df.shape[0], "rows")


# %%
# Drop columns that are not useful for analysis
cols_to_drop = ['Movies', 'Header image', 'Website', 'Support url',
                'Support email', 'Metacritic url', 'Screenshots',
                'About the game', 'Notes']

df.drop(columns=cols_to_drop, inplace=True, errors='ignore')
print("Columns dropped. Remaining columns:", df.shape[1])


# %%
# Fix numeric columns - fill NaN with 0 where 0 makes sense
num_cols = ['Average playtime forever', 'Median playtime forever',
            'Average playtime two weeks', 'Median playtime two weeks',
            'Metacritic score', 'User score', 'DLC count',
            'Achievements', 'Recommendations', 'Peak CCU', 'Score rank']

for col in num_cols:
    df[col] = pd.to_numeric(df[col], errors='coerce').fillna(0)

df['Price'] = pd.to_numeric(df['Price'], errors='coerce').fillna(0)
df['Positive'] = pd.to_numeric(df['Positive'], errors='coerce').fillna(0)
df['Negative'] = pd.to_numeric(df['Negative'], errors='coerce').fillna(0)

print("Numeric columns cleaned.")


# %%
# Parse release date
df['Release date'] = pd.to_datetime(df['Release date'], errors='coerce')
df['Release year'] = df['Release date'].dt.year
df['Release month'] = df['Release date'].dt.month

print("Release date parsed. Year range:", df['Release year'].min(), "to", df['Release year'].max())


# %%
# Parse Estimated owners - convert '100,000 - 200,000' to midpoint value
def parse_owners(s):
    try:
        s = str(s).replace(',', '').replace(' ', '')
        parts = s.split('-')
        low = float(parts[0])
        high = float(parts[1])
        return (low + high) / 2
    except:
        return np.nan

df['Owners midpoint'] = df['Estimated owners'].apply(parse_owners)

print("Estimated owners converted to midpoint.")
print("Sample values:")
print(df[['Estimated owners', 'Owners midpoint']].head())


# %%
# Final check after cleaning
print("Dataset after cleaning:")
print("Shape:", df.shape)
print("Null values remaining:", df.isnull().sum().sum())


# %% [markdown]
# ## 6. Feature Engineering
# 
# Here we create new columns from existing ones. These new features help us understand the data better and also improve our ML model later.
# 

# %%
# 1. Is the game free?
df['is_free'] = (df['Price'] == 0).astype(int)
print("is_free created")

# 2. Game age (how old is the game)
df['game_age'] = 2025 - df['Release year'].fillna(2025)
df['game_age'] = df['game_age'].clip(lower=0)
print("game_age created")

# 3. Is it a multiplayer game?
df['is_multiplayer'] = df['Categories'].fillna('').str.contains('Multi-player', case=False).astype(int)
print("is_multiplayer created")

# 4. Is it an indie game?
df['is_indie'] = df['Genres'].fillna('').str.contains('Indie', case=False).astype(int)
print("is_indie created")

# 5. Positive ratio (sentiment score between 0 and 1)
total_reviews = df['Positive'] + df['Negative']
df['positive_ratio'] = np.where(total_reviews > 0, df['Positive'] / total_reviews, np.nan)
print("positive_ratio created")

# 6. Engagement ratio
df['engagement_ratio'] = df['Average playtime forever'] / (df['Peak CCU'] + 1)
print("engagement_ratio created")

# 7. Has achievements?
df['has_achievements'] = (df['Achievements'] > 0).astype(int)
print("has_achievements created")

# 8. Revenue estimate (rough proxy)
df['revenue_estimate'] = df['Price'] * df['Owners midpoint'].fillna(0)
print("revenue_estimate created")

print()
print("All features created successfully")


