# %% [markdown]
# ## 9. Machine Learning
# 
# We will build two models:
# 1. **Linear Regression** — to predict a game's average playtime
# 2. **Logistic Regression** — to predict whether a game will be popular or not
# 

# %% [markdown]
# ### 9.1 Preparing the Data
# 

# %%
# Select features for ML
features = ['Price', 'is_free', 'is_multiplayer', 'is_indie',
            'has_achievements', 'game_age', 'DLC count', 'Achievements']

# Regression target: Average playtime
# Classification target: is_popular (top 40% owners = popular)
threshold = df['Owners midpoint'].quantile(0.60)
df['is_popular'] = (df['Owners midpoint'] >= threshold).astype(int)

print(f"Popularity threshold: {threshold:,.0f} owners")
print(f"Popular games: {df['is_popular'].sum():,}")
print(f"Not popular  : {(df['is_popular'] == 0).sum():,}")


# %%
# Build clean ML dataframe
ml_df = df[features + ['Average playtime forever', 'is_popular']].dropna()

# Remove rows with negative playtime
ml_df = ml_df[ml_df['Average playtime forever'] >= 0]

# Cap playtime at 99th percentile to remove extreme outliers
cap = ml_df['Average playtime forever'].quantile(0.99)
ml_df = ml_df[ml_df['Average playtime forever'] <= cap]

print("ML dataset shape:", ml_df.shape)
print()
print(ml_df[features].describe().round(2))


# %% [markdown]
# ### 9.2 Linear Regression — Predicting Average Playtime
# 

# %%
X = ml_df[features]
y_reg = ml_df['Average playtime forever']

X_train, X_test, y_train, y_test = train_test_split(X, y_reg, test_size=0.2, random_state=42)

# Scale the features
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

# Train linear regression
lr_model = LinearRegression()
lr_model.fit(X_train_scaled, y_train)

y_pred = lr_model.predict(X_test_scaled)

# Evaluation
rmse = np.sqrt(mean_squared_error(y_test, y_pred))
r2 = r2_score(y_test, y_pred)

print("Linear Regression Results — Predicting Average Playtime")
print("----------------------------------------------------------")
print(f"RMSE : {rmse:.2f} minutes")
print(f"R²   : {r2:.4f}")
print()
print(f"Interpretation: The model explains {r2*100:.1f}% of the variation in playtime.")
print("Playtime is hard to predict just from basic features — content quality matters more.")


# %%
# Feature coefficients
coef_df = pd.DataFrame({
    'Feature': features,
    'Coefficient': lr_model.coef_
}).sort_values('Coefficient', ascending=False)

print("Feature Coefficients:")
print(coef_df.to_string(index=False))
print()
print("Positive coefficient = increases playtime")
print("Negative coefficient = decreases playtime")


# %%
# Visualise: Actual vs Predicted playtime
plt.figure(figsize=(12, 5))

plt.subplot(1, 2, 1)
plt.scatter(y_test[:500], y_pred[:500], alpha=0.4, color='steelblue', s=15)
plt.plot([0, y_test.max()], [0, y_test.max()], color='red', linestyle='--')
plt.xlabel('Actual Playtime')
plt.ylabel('Predicted Playtime')
plt.title('Actual vs Predicted Playtime')

plt.subplot(1, 2, 2)
plt.barh(coef_df['Feature'], coef_df['Coefficient'], color='steelblue')
plt.axvline(0, color='black', linewidth=0.8)
plt.xlabel('Coefficient')
plt.title('Feature Importance (Coefficients)')

plt.tight_layout()
plt.show()


# %% [markdown]
# ### 9.3 Logistic Regression — Predicting Game Popularity
# 

# %%
X = ml_df[features]
y_cls = ml_df['is_popular']

X_train_c, X_test_c, y_train_c, y_test_c = train_test_split(
    X, y_cls, test_size=0.2, random_state=42, stratify=y_cls)

scaler_c = StandardScaler()
X_train_cs = scaler_c.fit_transform(X_train_c)
X_test_cs = scaler_c.transform(X_test_c)

log_model = LogisticRegression(max_iter=500, random_state=42)
log_model.fit(X_train_cs, y_train_c)

y_pred_c = log_model.predict(X_test_cs)

acc = accuracy_score(y_test_c, y_pred_c)
print("Logistic Regression Results — Predicting Game Popularity")
print("----------------------------------------------------------")
print(f"Accuracy : {acc:.4f} ({acc*100:.1f}%)")
print()
print(classification_report(y_test_c, y_pred_c, target_names=['Not Popular', 'Popular']))


# %%
# Confusion matrix
from sklearn.metrics import confusion_matrix

cm = confusion_matrix(y_test_c, y_pred_c)

plt.figure(figsize=(12, 5))

plt.subplot(1, 2, 1)
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',
            xticklabels=['Not Popular', 'Popular'],
            yticklabels=['Not Popular', 'Popular'])
plt.xlabel('Predicted')
plt.ylabel('Actual')
plt.title('Confusion Matrix')

plt.subplot(1, 2, 2)
log_coef = pd.DataFrame({
    'Feature': features,
    'Importance': np.abs(log_model.coef_[0])
}).sort_values('Importance')
plt.barh(log_coef['Feature'], log_coef['Importance'], color='steelblue')
plt.xlabel('Absolute Coefficient')
plt.title('Feature Importance (Logistic Regression)')

plt.tight_layout()
plt.show()

print("Insight: Even with basic features, the model shows reasonable accuracy.")
print("Features like is_free, is_multiplayer, and game_age are most predictive.")


